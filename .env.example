NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional and server-only. Required by the live monitoring ingestion writer.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Native Vercel Cron sends Authorization: Bearer <CRON_SECRET> to the GET route.
CRON_SECRET=
# eBay Browse API credentials. EBAY_ENVIRONMENT defaults to production and
# EBAY_MARKETPLACE_ID defaults to EBAY_AU when omitted by the runtime.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=
EBAY_MARKETPLACE_ID=
